        "isFull": {
          "description": "标签是否占据更大空间",
          "type": "boolean"
        },
        "className": {
          "description": "自定义样式类名",
          "type": "string"
        },
        "itemRender": {
          "description": "自定义项渲染函数",
          "type": "function"
        }
      }
    },
