      "props": {
        "list": {
          "description": "展示数据列表",
          "type": "array"
        },
        "labelAlign": {
          "description": "标签对齐方式",
          "type": "string"
        },
        "col": {
          "description": "每行显示的列数",
          "type": "number"
        },
        "gutter": {
          "description": "栅格间隔",
          "type": "number"
